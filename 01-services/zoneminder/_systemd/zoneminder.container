[Unit]
Requires=mariadb-zoneminder.service
After=mariadb-zoneminder.service

[Container]
Environment=TZ=America/Detroit
Environment=MYSQL_HOST=localhost
Environment=MYSQL_USER=zmuser
Secret=mariadb_zmuser_password,type=env,target=MYSQL_PASSWORD
Image=ghcr.io/zoneminder-containers/zoneminder-base:latest
Pod=web.pod
StopTimeout=45
Tmpfs=/dev/shm:size=1G
UserNS=auto
Volume=/nas/zm/db:/var/lib/mysql:ro
Volume=/nas/zm/run-mysqld:/run/mysqld:ro
Volume=/nas/zm/zm-data:/data
Volume=/nas/zm/zm-config:/config
Volume=/nas/zm/zm-log:/log

[Service]
Restart=on-failure
RestartSec=5s
